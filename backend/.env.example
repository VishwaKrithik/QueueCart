# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# =============================================================================
# PostgreSQL Database & ORM
# =============================================================================
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_secure_password
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
# Prisma / Drizzle connection string
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=10

# =============================================================================
# Redis Cache & Distributed Locking
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# RabbitMQ Message Broker
# =============================================================================
RABBITMQ_USER=rabbit_user
RABBITMQ_PASS=rabbit_secure_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}

# =============================================================================
# Authentication & Security
# =============================================================================
# Generate 256-bit secrets via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_bytes_min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_bytes_min
JWT_REFRESH_EXPIRATION=7d

COOKIE_SECRET=your_cookie_signing_secret_hash_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# =============================================================================
# AWS S3 Storage (Client-side Presigned URLs)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=production-ecommerce-media-bucket
AWS_S3_PRESIGNED_URL_EXPIRES_IN=300

# AWS / LocalStack S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_NAME=ecommerce-media-bucket
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_PRESIGNED_URL_EXPIRES_IN=300

# =============================================================================
# Observability & Logging
# =============================================================================
LOG_LEVEL=debug