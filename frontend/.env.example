# =============================================================================
# Vite App Configuration
# =============================================================================
VITE_NODE_ENV=development
VITE_APP_TITLE="NextGen Store"

# Base API Gateway URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Media Storage Public CDN Endpoint (CloudFront / Direct S3)
VITE_S3_ASSET_CDN_URL=https://production-ecommerce-media-bucket.s3.us-east-1.amazonaws.com

# Google OAuth Client Public ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com